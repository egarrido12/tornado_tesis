+# Approximate maximum length of the visible text of a shortened link.
+_LINKIFY_MAX_LEN = 30
+
+
+def _protocol_prefix_length(match: typing.Match[str]) -> int:
+    """Length of the ``proto://`` prefix of a match of `_URL_RE` (0 if absent)."""
+    proto = match.group(2)
+    if not proto:
+        return 0
+    return len(proto) + 1 + len(match.group(3) or "")  # +1 for the colon
+
+
+def _shorten_url(url: str, proto_len: int) -> str:
+    """Returns a shortened version of ``url`` for display in a link.
+
+    ``proto_len`` is the length of the protocol prefix, which is always kept.
+    If shortening would not make the text shorter, ``url`` is returned
+    unchanged.
+    """
+    shortened = url
+    parts = url[proto_len:].split("/")
+    if len(parts) > 1:
+        # Grab the whole host part plus the first bit of the path
+        # The path is usually not that interesting once shortened
+        # (no more slug, etc), so it really just provides a little
+        # extra indication of shortening.
+        shortened = (
+            url[:proto_len]
+            + parts[0]
+            + "/"
+            + parts[1][:8].split("?")[0].split(".")[0]
+        )
+
+    if len(shortened) > _LINKIFY_MAX_LEN * 1.5:  # still too long
+        shortened = shortened[:_LINKIFY_MAX_LEN]
+
+    if shortened == url:
+        return url
+
+    amp = shortened.rfind("&")
+    # avoid splitting html char entities
+    if amp > _LINKIFY_MAX_LEN - 5:
+        shortened = shortened[:amp]
+    shortened += "..."
+
+    if len(shortened) >= len(url):
+        return url
+    return shortened
+
 
