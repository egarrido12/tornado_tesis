+def _insert_before(
+    html: bytes, marker: bytes, insertion: bytes, *, last: bool = False
+) -> bytes:
+    """Inserts ``insertion`` (followed by a newline) before ``marker`` in ``html``.
+
+    The first occurrence of ``marker`` is used, or the last one if ``last``
+    is true. Raises `ValueError` if the marker is not present.
+    """
+    loc = html.rindex(marker) if last else html.index(marker)
+    return html[:loc] + insertion + b"\n" + html[loc:]
