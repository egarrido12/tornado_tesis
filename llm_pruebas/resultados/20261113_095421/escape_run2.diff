+# Links longer than this (approximately) are shortened for display when
+# linkify(shorten=True) is used.
+_MAX_LINK_LENGTH = 30
+
+
+def _shorten_link_text(
+    url: str, proto: str | None, slashes: str | None, href: str
+) -> tuple[str, str]:
+    """Shortens ``url`` for display as the text of a link.
+
+    ``proto`` and ``slashes`` are the protocol and the slashes following the
+    colon matched by `_URL_RE` (either may be empty or None).
+
+    Returns ``(display_url, extra_params)``, where ``extra_params`` is a
+    ``title`` attribute exposing the full link when the text was actually
+    shortened, and an empty string otherwise.
+    """
+    before_clip = url
+    if proto:
+        proto_len = len(proto) + 1 + len(slashes or "")  # +1 for :
+    else:
+        proto_len = 0
+
+    parts = url[proto_len:].split("/")
+    if len(parts) > 1:
+        # Grab the whole host part plus the first bit of the path
+        # The path is usually not that interesting once shortened
+        # (no more slug, etc), so it really just provides a little
+        # extra indication of shortening.
+        url = url[:proto_len] + parts[0] + "/" + parts[1][:8].split("?")[0].split(".")[0]
+
+    if len(url) > _MAX_LINK_LENGTH * 1.5:  # still too long
+        url = url[:_MAX_LINK_LENGTH]
+
+    if url == before_clip:
+        return url, ""
+
+    amp = url.rfind("&")
+    # avoid splitting html char entities
+    if amp > _MAX_LINK_LENGTH - 5:
+        url = url[:amp]
+    url += "..."
+
+    if len(url) >= len(before_clip):
+        return before_clip, ""
+    # full url is visible on mouse-over (for those who don't
+    # have a status bar, such as Safari by default)
+    return url, ' title="%s"' % href
+
 
