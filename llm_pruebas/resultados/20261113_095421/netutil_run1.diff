+def _remove_stale_unix_socket(file: str) -> None:
+    """Deletes ``file`` if it is a socket; raises if it is any other file."""
+    try:
+        st = os.stat(file)
+    except FileNotFoundError:
+        return
+    if stat.S_ISSOCK(st.st_mode):
+        os.remove(file)
+    else:
+        raise ValueError("File %s exists and is not a socket" % file)
+
