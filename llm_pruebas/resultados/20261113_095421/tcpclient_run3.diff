+    @staticmethod
+    def _absolute_deadline(
+        timeout: float | datetime.timedelta | None,
+    ) -> float | None:
+        """Converts a relative ``timeout`` to an absolute `.IOLoop` time.
+
+        Returns None if ``timeout`` is None. Raises `TypeError` for
+        unsupported types.
+        """
+        if timeout is None:
+            return None
+        if isinstance(timeout, numbers.Real):
+            return IOLoop.current().time() + timeout
+        if isinstance(timeout, datetime.timedelta):
+            return IOLoop.current().time() + timeout.total_seconds()
+        raise TypeError("Unsupported timeout %r" % timeout)
+
+    async def _resolve(
+        self,
+        host: str,
+        port: int,
+        af: socket.AddressFamily,
+        deadline: float | None,
+    ) -> list[tuple[int, Any]]:
+        """Resolves ``host``, failing with `TimeoutError` after ``deadline``."""
+        if deadline is None:
+            return await self.resolver.resolve(host, port, af)
+        return await gen.with_timeout(
+            deadline,
+            self.resolver.resolve(host, port, af),
+            message=f"Timeout while resolving {host}",
+        )
