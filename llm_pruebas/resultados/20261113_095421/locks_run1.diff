+    def _expire_waiter_after(
+        self,
+        waiter: Future[Any],
+        timeout: float | datetime.timedelta,
+        on_expire: Callable[[], None],
+    ) -> None:
+        """Arranges for ``on_expire`` to run if ``waiter`` is still pending
+        when ``timeout`` passes.
+
+        The timeout is cancelled as soon as ``waiter`` completes, and
+        timed-out waiters are periodically garbage-collected.
+        """
+
+        def on_timeout() -> None:
+            if not waiter.done():
+                on_expire()
+            self._garbage_collect()
+
+        io_loop = ioloop.IOLoop.current()
+        timeout_handle = io_loop.add_timeout(timeout, on_timeout)
+        waiter.add_done_callback(lambda _: io_loop.remove_timeout(timeout_handle))
 
