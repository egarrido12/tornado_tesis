+def _split_multipart_body(
+    boundary: bytes, data: bytes, config: ParseMultipartConfig
+) -> list[bytes]:
+    """Splits a multipart body into its (still encoded) parts."""
+    final_boundary_index = data.rfind(b"--" + boundary + b"--")
+    if final_boundary_index == -1:
+        raise HTTPInputError("Invalid multipart/form-data: no final boundary found")
+    parts = data[:final_boundary_index].split(
+        b"--" + boundary + b"\r\n", config.max_parts + 1
+    )
+    if len(parts) > config.max_parts:
+        raise HTTPInputError("multipart/form-data has too many parts")
+    return parts
+
+
+def _add_multipart_part(
+    part: bytes,
+    config: ParseMultipartConfig,
+    arguments: dict[str, list[bytes]],
+    files: dict[str, list[HTTPFile]],
+) -> None:
+    """Parses a single multipart part and records it in ``arguments`` or ``files``."""
+    eoh = part.find(b"\r\n\r\n")
+    if eoh == -1:
+        raise HTTPInputError("multipart/form-data missing headers")
+    if eoh > config.max_part_header_size:
+        raise HTTPInputError("multipart/form-data part header too large")
+    headers = HTTPHeaders.parse(part[:eoh].decode("utf-8"), _chars_are_bytes=False)
+    disp_header = headers.get("Content-Disposition", "")
+    disposition, disp_params = _parse_header(disp_header)
+    if disposition != "form-data" or not part.endswith(b"\r\n"):
+        raise HTTPInputError("Invalid multipart/form-data")
+    value = part[eoh + 4 : -2]
+    name = disp_params.get("name")
+    if not name:
+        raise HTTPInputError("multipart/form-data missing name")
+    filename = disp_params.get("filename")
+    if filename:
+        ctype = headers.get("Content-Type", "application/unknown")
+        files.setdefault(name, []).append(
+            HTTPFile(filename=filename, body=value, content_type=ctype)
+        )
+    else:
+        arguments.setdefault(name, []).append(value)
 
 
