+def _check_header_value(value: str, chars_are_bytes: bool) -> None:
+    """Raises `HTTPInputError` if ``value`` is not a valid header field value.
+
+    ``chars_are_bytes`` selects HTTP-style ABNF validation (the string is
+    bytes smuggled through latin1) or the more permissive validation used
+    for multipart/form-data (any non-control unicode character).
