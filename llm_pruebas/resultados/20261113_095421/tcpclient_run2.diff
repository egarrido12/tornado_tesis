+def _to_absolute_deadline(
+    timeout: float | datetime.timedelta | None,
+) -> float | None:
+    """Converts a relative or absolute ``timeout`` to an absolute deadline.
+
+    Numbers are interpreted as relative to the current time (see
+    `TCPClient.connect`); ``None`` means no timeout.
+    """
+    if timeout is None:
+        return None
+    if isinstance(timeout, numbers.Real):
+        return IOLoop.current().time() + timeout
+    if isinstance(timeout, datetime.timedelta):
+        return IOLoop.current().time() + timeout.total_seconds()
+    raise TypeError("Unsupported timeout %r" % timeout)
+
+
+def _source_bind_address(
+    af: socket.AddressFamily,
+    source_ip: str | None,
+    source_port: int | None,
+) -> tuple[str | None, int]:
+    """Returns the ``(ip, port)`` to bind to before connecting.
+
+    A port of 0 and an ip of ``None`` mean "no explicit binding".
+    """
+    port = source_port if isinstance(source_port, int) else 0
+    if port and not source_ip:
+        # User required a specific port, but did not specify
+        # a certain source IP, will bind to the default loopback.
+        # Trying to use the same address family as the requested af socket:
+        # - 127.0.0.1 for IPv4
+        # - ::1 for IPv6
+        return ("::1" if af == socket.AF_INET6 else "127.0.0.1"), port
+    return source_ip, port
 
 
