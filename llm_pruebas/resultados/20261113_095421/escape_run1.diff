+# Approximate maximum length of the displayed text of a link when
+# ``shorten=True`` is passed to `linkify`.
+_LINKIFY_MAX_URL_LENGTH = 30
+
+
+def _shorten_url_for_display(url: str, proto_len: int) -> str:
+    """Returns a shortened version of ``url`` suitable for link text.
+
+    ``proto_len`` is the length of the protocol prefix (including ``:`` and
+    slashes), which is always preserved. If shortening would not make the
+    text any shorter, the original ``url`` is returned unchanged.
+    """
+    max_len = _LINKIFY_MAX_URL_LENGTH
+    shortened = url
+
+    parts = url[proto_len:].split("/")
+    if len(parts) > 1:
+        # Grab the whole host part plus the first bit of the path
+        # The path is usually not that interesting once shortened
+        # (no more slug, etc), so it really just provides a little
+        # extra indication of shortening.
+        shortened = (
+            url[:proto_len]
+            + parts[0]
+            + "/"
+            + parts[1][:8].split("?")[0].split(".")[0]
+        )
+
+    if len(shortened) > max_len * 1.5:  # still too long
+        shortened = shortened[:max_len]
+
+    if shortened == url:
+        return url
+
+    amp = shortened.rfind("&")
+    # avoid splitting html char entities
+    if amp > max_len - 5:
+        shortened = shortened[:amp]
+    shortened += "..."
+
+    if len(shortened) >= len(url):
+        return url
+    return shortened
+
 
